{
  "name": "uknow-campaign-backend",
  "version": "1.0.1",
  "description": "UKNOW Campaign Management Backend",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "dev:e2e": "DOTENV_CONFIG_PATH=../e2e/.env.test nodemon -r dotenv/config src/index.js",
    "start:e2e": "DOTENV_CONFIG_PATH=../e2e/.env.test node -r dotenv/config src/index.js",
    "start": "node src/index.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:reload": "pm2 reload all",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 list",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "migrate:check": "node scripts/migrate.js --check",
    "backup:billing-anchor-repair": "node scripts/backupBillingAnchorRepair.js",
    "check:schema": "node scripts/checkCoreSchema.js",
    "check:bootstrap-columns": "node scripts/checkBootstrapColumns.js",
    "check:migration-safety": "node scripts/checkMigrationSafety.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects=unit --maxWorkers=50%",
    "test:unit": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects=unit --maxWorkers=50%",
    "test:integration": "NODE_ENV=test DB_POOL_MAX=20 node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects=integration --runInBand --forceExit --testTimeout=20000",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:coverage:unit": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects=unit --maxWorkers=50% --ci --coverage --coverageDirectory=coverage/unit --coverageReporters=json",
    "test:coverage:integration": "NODE_ENV=test DB_POOL_MAX=20 node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects=integration --runInBand --forceExit --testTimeout=20000 --ci --coverage --coverageDirectory=coverage/integration --coverageReporters=json",
    "test:coverage": "npm run test:coverage:unit && npm run test:coverage:integration && node scripts/mergeCoverage.js"
  },
  "jest": {
    "transform": {},
    "clearMocks": true,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js",
      "!src/config/**",
      "!src/**/__tests__/**",
      "!src/**/*.spec.js"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov",
      "html",
      "json-summary"
    ],
    "coverageDirectory": "coverage",
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "transform": {},
        "clearMocks": true,
        "testMatch": [
          "<rootDir>/src/**/__tests__/**/*.spec.js",
          "<rootDir>/src/**/*.spec.js"
        ]
      },
      {
        "displayName": "integration",
        "testEnvironment": "node",
        "transform": {},
        "clearMocks": true,
        "setupFilesAfterEnv": [
          "<rootDir>/tests/integration/jest-timeout.js"
        ],
        "testMatch": [
          "<rootDir>/tests/integration/**/*.test.js"
        ],
        "globalSetup": "<rootDir>/tests/integration/setup.js",
        "globalTeardown": "<rootDir>/tests/integration/teardown.js"
      }
    ]
  },
  "keywords": [
    "campaign",
    "marketing",
    "email",
    "zalo"
  ],
  "author": "UKNOW",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@payos/node": "^2.0.5",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.71.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "date-fns": "^2.30.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.1.0",
    "imapflow": "^1.7.6",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mailparser": "^3.9.16",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "papaparse": "^5.5.3",
    "pdf-parse": "^1.1.4",
    "pg": "^8.23.0",
    "puppeteer": "^25.8.0",
    "sanitize-html": "^2.17.5",
    "undici": "^7.24.7",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zca-js": "2.1.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
