# Telegram API credentials (from https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890

# Service config
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8765
GATEWAY_SECRET=change-me-shared-secret-with-nodejs

# Session storage
SESSION_DIR=./sessions

# Callback to Node.js backend
NODEJS_CALLBACK_URL=http://localhost:3000/internal/telegram-webhook
NODEJS_CALLBACK_SECRET=change-me-shared-secret

# Resource limits
MAX_CONCURRENT_CLIENTS=500
IDLE_DISCONNECT_MINUTES=5

# Logging
LOG_LEVEL=INFO
