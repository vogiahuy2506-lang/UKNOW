####################
# BACKEND (Node.js / Express)
####################
backend/node_modules/
backend/.env
# Legacy Baileys session folder (migration 213+214). The service no
# longer reads or writes here — everything is in Postgres. Keep the
# ignore line so a stale `node_modules`-style leak in a Docker build
# never gets committed. Operators should run
# `node scripts/backfillBaileysSessions.js` once and then `rm -rf`
# the folder manually.
backend/whatsapp-sessions/

# mtcute's local SQLite storage for the in-process Telegram gateway.
# These files hold auth keys and DC state. They MUST stay per-machine
# (committing them leaks auth state across worktrees).
backend/.telegram-mtcute-storage
backend/.telegram-mtcute-storage-shm
backend/.telegram-mtcute-storage-wal
backend/.telegram-test-storage

# Dev-only scratch helpers (release advisory locks, mint JWT for curl
# tests, dump DB state, dump process logs). These mutate the database
# and the running backend — they belong to a developer's terminal,
# not the repo. Keep them ignored so an accidental `git add .` in the
# backend folder never picks them up.
backend/.check_locks.cjs
backend/.release_locks.cjs
backend/.make_jwt.cjs
backend/.start.log
backend/.start.err
# One-off artefacts from local debugging (a QR image saved during a
# Baileys reconnect trial). Safe to keep ignored.
backend/real-qr-from-handler.png

# Conflict-resolution helper used during a one-shot merge back from
# origin/main. Keeps the script around so a follow-up `git pull
# --rebase` of similar shape can reuse it; not part of the runtime.
.resolve-conflicts.mjs

# Integration test overrides (Postgres local)
backend/tests/integration/.env.test


# Logs
backend/logs/
backend/*.log
frontend/*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

