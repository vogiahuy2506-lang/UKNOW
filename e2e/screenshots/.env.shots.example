# Tài khoản dùng để chụp ảnh minh hoạ bài hướng dẫn.
#
#   cp screenshots/.env.shots.example screenshots/.env.shots
#   rồi điền vào screenshots/.env.shots (file này đã được gitignore)
#
# Nên dùng tài khoản CHỦ WORKSPACE: nhiều màn hình trong bài hướng dẫn chỉ chủ
# tài khoản mới thấy (nhóm Gói & Thanh toán, Hồ sơ doanh nghiệp, Nhân viên).

HELP_SHOT_USERNAME=
HELP_SHOT_PASSWORD=

# Site để chụp. Bỏ trống là dùng https://founderai.biz
HELP_SHOT_BASE_URL=
