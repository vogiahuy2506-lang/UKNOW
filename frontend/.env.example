# Gốc API (vd http://localhost:5001/api hoặc https://host/api). Không lặp /api/api — snippet lp-track sẽ chuẩn hóa nếu lỡ cấu hình trùng.
VITE_API_URL=

# IP public của server landing page — dùng làm giá trị A-record khi khách trỏ apex domain.
# Nếu để trống: frontend sẽ hiển thị placeholder và đợi backend trả `dnsRecords[].value` qua
# GET /api/landing-pages/admin/:id/custom-domain. Ưu tiên backend hơn env.
VITE_LANDING_SERVER_IP=

# Platform sender domain — shown in UI for email settings
VITE_DEFAULT_FROM_DOMAIN=founderai.biz

# App chính: danh sách hostname (phẩy). Host khác → chỉ render landing custom domain.
VITE_PRIMARY_APP_HOSTS=localhost,127.0.0.1

# Google Analytics 4 — đo lưu lượng trước đăng ký (nguồn truy cập → đăng ký → trả tiền).
# Để trống = không nạp gì (dev/test). Chỉ chạy trên host trong VITE_PRIMARY_APP_HOSTS,
# không bao giờ nạp trên custom domain landing của khách.
VITE_GA_MEASUREMENT_ID=

# VAT invoice UI at checkout only (Topup has no VAT form). Keep false until Mat Bao rollout.
# VITE_INVOICE_VAT_ENABLED=false

# Feature Flags (Mặc định false — mở theo quyết định phát hành sản phẩm)
VITE_FEATURE_LANDING_CMS=false
VITE_FEATURE_ORDERS=false
VITE_FEATURE_COURSES=false
VITE_FEATURE_PRODUCTS=false
