// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FormRenderer — không có form.product thì DOM giữ y hệt bản cũ > bố cục thường (không theme) 1`] = `"<div class="w-full max-w-xl mx-auto bg-white text-slate-800 rounded-2xl shadow-sm border border-gray-100 overflow-hidden overflow-x-hidden box-border" style="color-scheme: light;"><div class="p-4 sm:p-6"><div class="mb-6"><h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2 break-words">Biểu mẫu bán hàng</h1><p class="text-gray-600 text-sm sm:text-base whitespace-pre-line break-words leading-relaxed">Điền thông tin để đặt mua.</p></div><form novalidate="" class="space-y-5"><div style="opacity: 0; position: absolute; top: 0px; left: 0px; height: 0px; width: 0px; z-index: -1;" aria-hidden="true"><label for="_hp_website">Do not fill this</label><input id="_hp_website" type="text" name="_hp_website" tabindex="-1" autocomplete="off" value=""></div><div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-5"><div class="min-w-0 space-y-1.5 sm:col-span-2"><label for="field_f_name" class="block text-sm font-medium text-gray-800 break-words">Họ tên<span class="text-red-500 ml-1">*</span></label><input id="field_f_name" type="text" maxlength="500" class="w-full px-3.5 py-2.5 rounded-xl border text-sm transition-colors focus:outline-none focus:ring-2 border-gray-300 focus:border-primary-500 focus:ring-primary-100" value=""></div><div class="min-w-0 space-y-1.5 sm:col-span-2"><label for="field_f_phone" class="block text-sm font-medium text-gray-800 break-words">Số điện thoại<span class="text-red-500 ml-1">*</span></label><input id="field_f_phone" type="tel" maxlength="50" class="w-full px-3.5 py-2.5 rounded-xl border text-sm transition-colors focus:outline-none focus:ring-2 border-gray-300 focus:border-primary-500 focus:ring-primary-100" value=""></div><div class="min-w-0 space-y-1.5 sm:col-span-2"><label for="field_f_pick" class="block text-sm font-medium text-gray-800 break-words">Gói</label><select id="field_f_pick" class="w-full px-3.5 py-2.5 rounded-xl border text-sm transition-colors focus:outline-none focus:ring-2 bg-white border-gray-300 focus:border-primary-500 focus:ring-primary-100"><option value="">-- Chọn lựa chọn --</option><option value="A">A</option></select></div></div><div class="pt-2"><label class="flex items-start gap-3 cursor-pointer text-sm text-gray-700 select-none"><input type="checkbox" class="mt-0.5 h-4 w-4 rounded text-[color:var(--form-primary,#df5c0e)] focus:ring-primary-500 border-gray-300"><span class="leading-snug">Tôi đồng ý nhận thông tin tư vấn và ưu đãi tiếp thị.</span></label></div><div class="pt-4 flex items-stretch gap-3"><button type="submit" class="w-full py-3 px-6 rounded-xl font-medium text-[color:var(--form-primary-text,#ffffff)] bg-[color:var(--form-primary,#df5c0e)] hover:brightness-95 active:scale-[0.99] transition-all disabled:opacity-50 disabled:cursor-not-allowed shadow-sm">Gửi thông tin</button></div></form></div></div>"`;

exports[`FormRenderer — không có form.product thì DOM giữ y hệt bản cũ > bố cục wide + màu chủ đạo + banner + logo 1`] = `"<div class="w-full max-w-2xl mx-auto bg-white text-slate-800 rounded-2xl  overflow-hidden overflow-x-hidden box-border" style="color-scheme: light; --form-primary: #0f766e; --form-primary-text: #FFFFFF; --form-primary-tint: #0f766e1a;"><img src="https://cdn.example.com/b.png" alt="" style="height: 10rem;" class="w-full object-cover"><div class="p-4 sm:p-6"><div class="mb-6"><img src="https://cdn.example.com/l.png" alt="" class="h-12 max-w-[200px] object-contain mb-3"><h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2 break-words">Biểu mẫu bán hàng</h1><p class="text-gray-600 text-sm sm:text-base whitespace-pre-line break-words leading-relaxed">Điền thông tin để đặt mua.</p></div><form novalidate="" class="space-y-5"><div style="opacity: 0; position: absolute; top: 0px; left: 0px; height: 0px; width: 0px; z-index: -1;" aria-hidden="true"><label for="_hp_website">Do not fill this</label><input id="_hp_website" type="text" name="_hp_website" tabindex="-1" autocomplete="off" value=""></div><div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-5"><div class="min-w-0 space-y-1.5 sm:col-span-2"><label for="field_f_name" class="block text-sm font-medium text-gray-800 break-words">Họ tên<span class="text-red-500 ml-1">*</span></label><input id="field_f_name" type="text" maxlength="500" class="w-full px-3.5 py-2.5 rounded-xl border text-sm transition-colors focus:outline-none focus:ring-2 border-gray-300 focus:border-primary-500 focus:ring-primary-100" value=""></div><div class="min-w-0 space-y-1.5 sm:col-span-2"><label for="field_f_phone" class="block text-sm font-medium text-gray-800 break-words">Số điện thoại<span class="text-red-500 ml-1">*</span></label><input id="field_f_phone" type="tel" maxlength="50" class="w-full px-3.5 py-2.5 rounded-xl border text-sm transition-colors focus:outline-none focus:ring-2 border-gray-300 focus:border-primary-500 focus:ring-primary-100" value=""></div><div class="min-w-0 space-y-1.5 sm:col-span-2"><label for="field_f_pick" class="block text-sm font-medium text-gray-800 break-words">Gói</label><select id="field_f_pick" class="w-full px-3.5 py-2.5 rounded-xl border text-sm transition-colors focus:outline-none focus:ring-2 bg-white border-gray-300 focus:border-primary-500 focus:ring-primary-100"><option value="">-- Chọn lựa chọn --</option><option value="A">A</option></select></div></div><div class="pt-2"><label class="flex items-start gap-3 cursor-pointer text-sm text-gray-700 select-none"><input type="checkbox" class="mt-0.5 h-4 w-4 rounded text-[color:var(--form-primary,#df5c0e)] focus:ring-primary-500 border-gray-300"><span class="leading-snug">Tôi đồng ý nhận thông tin tư vấn và ưu đãi tiếp thị.</span></label></div><div class="pt-4 flex items-stretch gap-3"><button type="submit" class="w-full py-3 px-6 rounded-xl font-medium text-[color:var(--form-primary-text,#ffffff)] bg-[color:var(--form-primary,#df5c0e)] hover:brightness-95 active:scale-[0.99] transition-all disabled:opacity-50 disabled:cursor-not-allowed shadow-sm">Gửi thông tin</button></div></form></div></div>"`;

exports[`FormRenderer — không có form.product thì DOM giữ y hệt bản cũ > xem trước điện thoại (singleColumn) + previewMode 1`] = `"<div class="w-full max-w-xl mx-auto bg-white text-slate-800 rounded-2xl shadow-sm border border-gray-100 overflow-hidden overflow-x-hidden box-border" style="color-scheme: light;"><div class="p-4 sm:p-6"><div class="mb-6"><h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2 break-words">Biểu mẫu bán hàng</h1><p class="text-gray-600 text-sm sm:text-base whitespace-pre-line break-words leading-relaxed">Điền thông tin để đặt mua.</p></div><form novalidate="" class="space-y-5"><div style="opacity: 0; position: absolute; top: 0px; left: 0px; height: 0px; width: 0px; z-index: -1;" aria-hidden="true"><label for="_hp_website">Do not fill this</label><input id="_hp_website" type="text" name="_hp_website" tabindex="-1" autocomplete="off" value=""></div><div class="grid grid-cols-1  gap-x-4 gap-y-5"><div class="min-w-0 space-y-1.5 "><label for="field_f_name" class="block text-sm font-medium text-gray-800 break-words">Họ tên<span class="text-red-500 ml-1">*</span></label><input id="field_f_name" type="text" maxlength="500" class="w-full px-3.5 py-2.5 rounded-xl border text-sm transition-colors focus:outline-none focus:ring-2 border-gray-300 focus:border-primary-500 focus:ring-primary-100" disabled="" value=""></div><div class="min-w-0 space-y-1.5 "><label for="field_f_phone" class="block text-sm font-medium text-gray-800 break-words">Số điện thoại<span class="text-red-500 ml-1">*</span></label><input id="field_f_phone" type="tel" maxlength="50" class="w-full px-3.5 py-2.5 rounded-xl border text-sm transition-colors focus:outline-none focus:ring-2 border-gray-300 focus:border-primary-500 focus:ring-primary-100" disabled="" value=""></div><div class="min-w-0 space-y-1.5 "><label for="field_f_pick" class="block text-sm font-medium text-gray-800 break-words">Gói</label><select id="field_f_pick" class="w-full px-3.5 py-2.5 rounded-xl border text-sm transition-colors focus:outline-none focus:ring-2 bg-white border-gray-300 focus:border-primary-500 focus:ring-primary-100" disabled=""><option value="">-- Chọn lựa chọn --</option><option value="A">A</option></select></div></div><div class="pt-2"><label class="flex items-start gap-3 cursor-pointer text-sm text-gray-700 select-none"><input type="checkbox" disabled="" class="mt-0.5 h-4 w-4 rounded text-[color:var(--form-primary,#df5c0e)] focus:ring-primary-500 border-gray-300"><span class="leading-snug">Tôi đồng ý nhận thông tin tư vấn và ưu đãi tiếp thị.</span></label></div><div class="pt-4 flex items-stretch gap-3"><button type="submit" disabled="" class="w-full py-3 px-6 rounded-xl font-medium text-[color:var(--form-primary-text,#ffffff)] bg-[color:var(--form-primary,#df5c0e)] hover:brightness-95 active:scale-[0.99] transition-all disabled:opacity-50 disabled:cursor-not-allowed shadow-sm">Gửi thông tin</button></div></form></div></div>"`;
